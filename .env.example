# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_TOKEN=MTQ5NjY5MDA1NTQ0NjUyODA4MQ.GAA9dk.oB2q2pBcRxYes4R03RiIqr6-4UhdhVR3aB6dz4 # Fake token, replace with your actual token

# LLM: Install Ollama (https://ollama.ai) and run 'ollama pull mistral' for local Mistral 7B
# No API key needed - runs locally
OLLAMA_MODEL=mistral

# Base URL of the Ollama server. Only change this if Ollama runs on a different
# machine than this process (e.g. src/ingest_lore.py or src/ask.py run from your
# laptop against a remote GPU server -- see EXTERNAL_SERVER_SETUP.md). That server
# must be reachable at this address (e.g. via Tailscale/SSH tunnel, not the open
# internet -- Ollama has no built-in auth).
OLLAMA_HOST=http://localhost:11434

# Embedding model for /recall and cross-session continuity (RAG).
# Run 'ollama pull nomic-embed-text' once. Optional -- degrades gracefully if unset/unreachable.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Where past session summaries are stored for /recall and RAG (local, file-based).
# Ignored if CHROMA_HOST is set below.
VECTOR_STORE_DIR=vector_store

# If set, connect to a networked Chroma server (`chroma run`) instead of the local
# embedded store. Needed for src/ingest_lore.py / src/ask.py to reach the same
# vector store from a different machine than the bot -- see EXTERNAL_SERVER_SETUP.md.
# Leave unset to keep using the local embedded store (the default).
# CHROMA_HOST=desktop.local
# CHROMA_PORT=8000

# Transcription Service - 'faster-whisper' for local, 'google' for Google Speech API
TRANSCRIPTION_SERVICE=faster-whisper

# faster-whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# faster-whisper device: 'auto' (uses GPU if available), 'cpu', or 'cuda'.
# On an NVIDIA GPU machine, also try WHISPER_COMPUTE_TYPE=float16 for a real speed win.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8


# Default text channel ID for transcriptions (optional)
DEFAULT_TEXT_CHANNEL_ID=your_channel_id_here
